{
  "private": true,
  "name": "eslint-lumir",
  "version": "0.20.0",
  "type": "module",
  "sideEffects": false,
  "description": "Lumir's ESLint config preset",
  "exports": {
    "./js": {
      "types": "./build/configs/js.d.ts",
      "default": "./build/configs/js.js"
    },
    "./ts": {
      "types": "./build/configs/ts.d.ts",
      "default": "./build/configs/ts.js"
    },
    "./jsx": {
      "types": "./build/configs/jsx.d.ts",
      "default": "./build/configs/jsx.js"
    },
    "./tsx": {
      "types": "./build/configs/tsx.d.ts",
      "default": "./build/configs/tsx.js"
    },
    "./next": {
      "types": "./build/configs/next.d.ts",
      "default": "./build/configs/next.js"
    },
    "./json": {
      "types": "./build/configs/json.d.ts",
      "default": "./build/configs/json.js"
    },
    "./jsonc": {
      "types": "./build/configs/jsonc.d.ts",
      "default": "./build/configs/jsonc.js"
    },
    "./json5": {
      "types": "./build/configs/json5.d.ts",
      "default": "./build/configs/json5.js"
    },
    "./md": {
      "types": "./build/configs/md.d.ts",
      "default": "./build/configs/md.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "js": [
        "./build/configs/js.d.ts"
      ],
      "ts": [
        "./build/configs/ts.d.ts"
      ],
      "jsx": [
        "./build/configs/jsx.d.ts"
      ],
      "tsx": [
        "./build/configs/tsx.d.ts"
      ],
      "next": [
        "./build/configs/next.d.ts"
      ],
      "json": [
        "./build/configs/json.d.ts"
      ],
      "jsonc": [
        "./build/configs/jsonc.d.ts"
      ],
      "json5": [
        "./build/configs/json5.d.ts"
      ],
      "md": [
        "./build/configs/md.d.ts"
      ]
    }
  },
  "files": [
    "build",
    "LICENSE.md",
    "README.md"
  ],
  "keywords": [
    "eslint-lumir",
    "eslint",
    "eslintconfig",
    "eslint-config",
    "config",
    "flat",
    "flat-config",
    "javascript",
    "typescript",
    "react",
    "nextjs",
    "markdown",
    "js",
    "ts",
    "jsx",
    "tsx",
    "json",
    "jsonc",
    "json5",
    "md"
  ],
  "author": "lumir <rpfos@naver.com> (https://github.com/lumirlumir)",
  "funding": "https://github.com/sponsors/lumirlumir",
  "license": "MIT",
  "homepage": "https://eslint-markdown.lumir.page",
  "repository": {
    "type": "github",
    "url": "git+https://github.com/eslint-markdown/eslint-markdown.git",
    "directory": "packages/eslint-lumir"
  },
  "bugs": {
    "url": "https://github.com/eslint-markdown/eslint-markdown/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc -b tsconfig.build.json",
    "test": "npm run test:types && npm run test:unit",
    "test:types": "tsc -b tsconfig.json",
    "test:unit": "vitest run"
  },
  "peerDependencies": {
    "@next/eslint-plugin-next": "^16.3.0",
    "eslint": "^10.3.0"
  },
  "peerDependenciesMeta": {
    "@next/eslint-plugin-next": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.28.6",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint-markdown": "^0.20.0",
    "eslint-plugin-import-lite": "^0.6.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.2",
    "@typescript-eslint/utils": "^8.72.0",
    "eslint": "^10.13.0"
  }
}
